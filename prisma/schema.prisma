// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  role           String          @default("user")
  banned         Boolean         @default(false)
  banReason      String?
  banExpires     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  comments       Comment[]
  categories     Category[]
  posts          Post[]
  links          Link[]
  logs           Log[]
  postImages     PostImage[]
  videos         Video[]
  videoBookmarks VideoBookmark[]
  fileAssets     FileAsset[]
  hikes          Hike[]
  tracks         Track[]
  photos         Photo[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model MdDoc {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  previewImageUrl String?
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("BlogPost")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId, videoId])
}

// Updated Posts model - start
model Post {
  id         String     @id @default(uuid())
  title      String
  slug       String     @unique
  content    String
  imageUrl   String
  views      Int        @default(0)
  tags       String[]
  status     PostStatus @default(published)
  userId     String
  user       User       @relation(references: [id], fields: [userId], onDelete: Cascade)
  categoryId String?
  category   Category?  @relation(references: [id], fields: [categoryId], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  links       LinksToPosts[]
  images      PostImage[]
  contentTags PostsToContentTags[]
}

model ContentTag {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  status    ContentTagStatus     @default(ACTIVE)
  posts     PostsToContentTags[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  @@index([status])
  @@index([name])
}

model PostsToContentTags {
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  tag        ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String
  assignedAt DateTime   @default(now())

  @@id([postId, tagId])
  @@index([tagId])
}

model PostImage {
  id        String   @id @default(uuid())
  url       String
  fileKey   String? // UploadThing file key, for deleting from storage
  userId    String? // User who uploaded the image
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum PostStatus {
  published
  draft
}

enum ContentTagStatus {
  ACTIVE
  NEEDS_REVIEW
}

// Updated Posts model - finish

// Outdoor content - start
enum HikeStatus {
  DRAFT
  PUBLISHED
}

enum TrackStatus {
  DRAFT
  PUBLISHED
}

enum PhotoStatus {
  DRAFT
  PUBLISHED
}

enum HikeType {
  HIKING
  MOUNTAIN
  WATER
  SKI
  BIKE
  OTHER
}

model Hike {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  description String?
  startDate   DateTime
  endDate     DateTime
  type        HikeType
  status      HikeStatus @default(DRAFT)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@index([userId])
}

model Track {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String?
  status      TrackStatus @default(DRAFT)
  fileAssetId String      @unique
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  metadata    Json?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([status])
  @@index([userId])
}

model Photo {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      PhotoStatus  @default(DRAFT)
  metadata    Json?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      PhotoImage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([status])
  @@index([userId])
  @@index([updatedAt])
}

model PhotoImage {
  id          String    @id @default(uuid())
  photoId     String
  photo       Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  fileAssetId String    @unique
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  sortOrder   Int
  createdAt   DateTime  @default(now())

  @@unique([photoId, sortOrder])
  @@index([photoId])
}

// Outdoor content - finish

// File assets - start
enum FileAssetProvider {
  UPLOADTHING
}

enum FileAssetPurpose {
  ADMIN_UPLOAD
  ARCHIVE_ATTACHMENT
  VIDEO_ATTACHMENT
  PREVIEW_IMAGE
  RICH_TEXT_IMAGE
  STANDALONE_SHARED_FILE
  TRACK_GPX
  OUTDOOR_PHOTO_IMAGE
}

enum FileAssetVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum FileAssetStatus {
  ACTIVE
  DETACHED
  PENDING_DELETE
  DELETED
}

model FileAsset {
  id           String              @id @default(uuid())
  provider     FileAssetProvider   @default(UPLOADTHING)
  fileKey      String              @unique
  customId     String?
  url          String
  name         String
  mimeType     String
  sizeBytes    Int
  purpose      FileAssetPurpose    @default(ADMIN_UPLOAD)
  visibility   FileAssetVisibility @default(PRIVATE)
  status       FileAssetStatus     @default(ACTIVE)
  ownerUserId  String
  owner        User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  track        Track?
  photoImages  PhotoImage[]
  uploadedAt   DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  deletedAt    DateTime?

  @@index([ownerUserId, status])
  @@index([purpose])
  @@index([visibility])
  @@index([uploadedAt])
}

// File assets - finish

// Link - start
model Link {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  url         String
  shortCode   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  posts LinksToPosts[]
}

model LinksToPosts {
  post       Post     @relation(fields: [postId], references: [id])
  postId     String // relation scalar field (used in the `@relation` attribute above)
  link       Link     @relation(fields: [linkId], references: [id])
  linkId     String // relation scalar field (used in the `@relation` attribute above)
  assignedAt DateTime @default(now())

  @@id([postId, linkId])
}

// Link - finish

// Video - start
enum VideoVisibility {
  PRIVATE
  PUBLIC
}

enum VideoChannelVisibility {
  PUBLIC
  HIDDEN
}

model VideoChannel {
  id         String                 @id @default(uuid())
  name       String
  url        String
  imageUrl   String?
  visibility VideoChannelVisibility @default(PUBLIC)
  videos     Video[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt

  @@index([visibility])
}

model Video {
  id              String              @id @default(uuid())
  title           String
  url             String
  thumbnailUrl    String?
  videoDate       DateTime
  visibility      VideoVisibility     @default(PRIVATE)
  provider        String?
  providerVideoId String?
  embedUrl        String?
  durationSeconds Int?
  channelId       String?
  channel         VideoChannel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  tags            VideosToVideoTags[]
  bookmarks       VideoBookmark[]
  comments        Comment[]
  userId          String
  user            User                @relation(references: [id], fields: [userId], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([userId])
  @@index([videoDate])
  @@index([visibility])
  @@index([provider, providerVideoId])
  @@index([channelId])
}

model VideoTag {
  id        String              @id @default(uuid())
  name      String
  slug      String              @unique
  videos    VideosToVideoTags[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt

  @@index([name])
}

model VideosToVideoTags {
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String
  tag        VideoTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String
  assignedAt DateTime @default(now())

  @@id([videoId, tagId])
  @@index([tagId])
}

model VideoBookmark {
  id               String   @id @default(uuid())
  videoId          String
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestampSeconds Int
  label            String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([userId, videoId, timestampSeconds])
  @@index([videoId])
}

// Video - finish

// Logging model - start
enum LogAction {
  createPost
  updatePost
  deletePost
  goToLink
}

model Log {
  id        String   @id @default(uuid())
  action    String
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  details   String?
  createdAt DateTime @default(now())
}

// Logging model - finish
